[Unit]
Description=Fritz to InfluxDB daemon
Wants=network-online.target
After=network-online.target

[Service]
User=pi
Type=simple
WorkingDirectory=/home/pi/fritzinfluxdb
ExecStart=/home/pi/fritzinfluxdb/venv/bin/python /home/pi/fritzinfluxdb/fritzinfluxdb.py -d
RemainAfterExit=no
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
